@page "/"
@using B2.App.Dtos
@using B2.Frontend.Fetchers
@using B2.Frontend.Services

@inject IProductFetcher ProductFetcher
@inject ICartService Cart
@inject StatusService Status

<PageTitle>Catalogue</PageTitle>

@code{
    List<ProductDto>? _products;

    ProductDto? _selectedProduct;

    protected override async Task OnInitializedAsync()
    {
        var products = await ProductFetcher.GetAllProductsAsync(_dto);

        if (products != null)
            _products = [.. products];
        else
            _products = [];
    }

    async Task AddToCart(ListingDto product, Guid sellerId)
    {
        await Cart.AddToCartAsync(product, sellerId);

        await Status.SetStatusAsync("Added successfully!", StatusService.StatusType.Success);
    }

    PaginationDto _dto = new();

    async Task Prev()
    {
        _dto.Page--;
        if (_dto.Page <= 1)
            _dto.Page = 1;
        await OnInitializedAsync();
    }

    async Task Next()
    {
        _dto.Page++;
        await OnInitializedAsync();
    }

    void UpdateSelected(ProductDto dto)
    {
        _selectedProduct = _selectedProduct == dto ? null : dto;
    }

    RenderFragment DisplayProductsTable => @<table class="table">
                                               <thead>
                                               <tr>
                                                   <th class="w-15">Name</th>
                                                   <th>Category</th>
                                                   <th class="w-15">Price</th>
                                                   <th class="w-15"></th>
                                               </tr>
                                               </thead>

                                               <tbody>
                                               @foreach (var product in _products)
                                               {
                                                   <tr>
                                                       <td>
                                                           <a class="h4">@product.Name</a></td>
                                                       <td>@(string.IsNullOrEmpty(product.Description) ? "No description available." : product.Description)</td>
                                                       <td>@product.Category</td>
                                                       <td><button class="btn btn-info"
                                                                   @onclick="() => UpdateSelected(product)">
                                                           View listings
                                                       </button></td>
                                                   </tr>
                                               }
                                               </tbody>
                                           </table>;

    RenderFragment DisplayListings => @<table class="table">
                                               <thead>
                                               <tr>
                                                   <th class="w-15">Seller name</th>
                                                   <th class="w-auto">Delivery methods</th>
                                                   <th class="w-15">Price</th>
                                               </tr>
                                               </thead>

                                               <tbody>
                                               @foreach (var listing in _selectedProduct.Listings)
                                               {
                                                   <tr>
                                                       <td>
                                                           <a class="h4">@listing.Seller.Name</a></td>
                                                       <td>@(string.Join(", ", listing.Seller.SupportedDeliveryMethods.Select(d => $"{d.Name}")))</td>
                                                       <td>@listing.Price $
                                                           <button class="btn btn-success"
                                                                   @onclick="() => AddToCart(listing, listing.Seller.Id)">Add to cart
                                                           </button>
                                                       </td>
                                                   </tr>
                                               }
                                               </tbody>
                                           </table>;

}

<EditForm Model="_dto">
    <ChildContent Context="editContext">
        <button class="btn btn-info" @onclick="Prev"> Previous</button>
        @_dto.Page
        <button class="btn btn-info" @onclick="Next"> Next</button>
        <br/>

        <br/>
        <select class="form-select form-select-sm w-auto" @bind="_dto.PageSize" @bind:after="OnInitializedAsync">
            <option value="1">1</option>
            <option value="5">5</option>
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="25">50</option>
            <option value="0">All</option>
            <br/>
        </select>
    </ChildContent>
</EditForm>

@if (_products == null)
{
    <p> Loading... </p>
}
else if (_products.Count == 0)
{
    <p> No products yet :( </p>
}
else
{
    if (_selectedProduct != null)
    {
        <table class="table">
            <tbody>
            <tr>
                <td>@DisplayProductsTable</td>
                <td>@DisplayListings</td>
            </tr>
            </tbody>
        </table>
    }
    else
    {
        @DisplayProductsTable;
    }
}
